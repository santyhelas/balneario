# Copiar a .env.local para desarrollo. En Vercel se cargan en Settings → Environment Variables.
# Son datos públicos: la seguridad la dan los permisos de la base (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# NUNCA poner acá la clave "secret"/"service_role" ni la contraseña de la base.

# Clave SECRETA del servidor (Supabase → Project Settings → API Keys → "secret", empieza con sb_secret_).
# Se usa SOLO en el servidor para: ingresar con usuario y crear cuentas. Nunca va al navegador
# (no lleva el prefijo NEXT_PUBLIC_). En Vercel: Settings → Environment Variables.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Clima actual cada ~10 minutos (opcional). Clave gratis de https://openweathermap.org (plan Free).
# Va SOLO en el servidor (Vercel → Environment Variables), nunca con NEXT_PUBLIC_.
OPENWEATHER_API_KEY=

# Copias en Google Drive (opcional). Cliente OAuth "Aplicación web" de Google Cloud,
# con la URI de redireccionamiento https://TU-DOMINIO/api/drive/callback y la API de Google Drive activada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dirección pública de la web (para Google y el mapa del sitio). Ej: https://tubalneario.vercel.app
NEXT_PUBLIC_SITE_URL=
# Código de verificación de Google Search Console (solo el código, sin la etiqueta <meta>)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
